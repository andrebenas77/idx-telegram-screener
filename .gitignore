# SECRETS — never push. Telegram API keys + login session grant account access.
# NOTE: 'secrets/*' (contents), not 'secrets/' (the directory) — git cannot
# re-include a file whose parent DIRECTORY is excluded, and we need the
# credential-free .env.example to ship so a fresh clone can be set up.
secrets/*
!secrets/.env.example
*.session
*.session-journal
.env

# Your channel list can name PRIVATE channels — keep it local on a public repo.
# (The published site only ever shows a channel COUNT, never names.)
reference/channels.txt

# Working intermediates — regenerated every run (published output lives in docs/)
build/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
