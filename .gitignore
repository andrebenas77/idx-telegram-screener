# SECRETS — never push. Telegram API keys + login session grant account access.
# NOTE: 'secrets/*' (contents), not 'secrets/' (the directory) — git cannot
# re-include a file whose parent DIRECTORY is excluded, and we need the
# credential-free .env.example to ship so a fresh clone can be set up.
secrets/*
!secrets/.env.example
*.session
*.session-journal
.env

# Your channel list can name PRIVATE channels — keep it local on a public repo.
# (The published site only ever shows a channel COUNT, never names.)
reference/channels.txt

# Working intermediates — regenerated every run (published output lives in docs/)
build/

# Licensed vendor data. This repo is PUBLIC and serves GitHub Pages; Invezgo tick data is
# a paid feed, and republishing it verbatim would redistribute someone else's licensed
# product. Derived signals (scores, flags, aggregates) are fine to publish — the raw tape
# is not. Keep the archive local, or move it to a private repo if it needs backing up.
data/tape/

# Same reasoning, different shape: the backfilled panel is ~7.6 MB of per-broker daily
# net flow derived from Invezgo's inventory-chart feed. It is much closer to their raw
# product than to a derived signal, so it stays out of a public repo. It is also
# reproducible — `py scripts/backfill_panel.py` rebuilds it in ~113 requests — so there
# is nothing here that needs versioning.
data/panel/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
