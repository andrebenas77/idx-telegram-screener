# Trade layer configuration. Copy to secrets/trade.env and fill in.
# secrets/* is gitignored; secrets/*.example is the only thing that ships.
#
# The environment overrides this file, so systemd can inject values on the VPS
# without editing anything (same precedence as notify_telegram.py).

# Account equity in rupiah. Until this is set, trade_plan.py uses a Rp100,000,000
# placeholder and says so on every run — the lot counts are fiction without it.
TRADE_EQUITY_IDR=100000000

# Risk per trade as a fraction of equity. 0.015 = 1.5%, sized for a concentrated
# book of 1-3 positions. Note that at this level the NOTIONAL cap (30% of equity)
# binds before the risk budget on low-volatility names — trade_plan.py prints
# which constraint bound each line.
TRADE_RISK_PCT=0.015

# Your broker's actual rates. These are not cosmetic: a ~0.4% round trip is
# roughly a third of the strategy's gross edge, and the defaults below are a guess.
TRADE_FEE_BUY=0.0015
TRADE_FEE_SELL=0.0025
