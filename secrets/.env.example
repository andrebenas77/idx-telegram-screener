# ---------------------------------------------------------------------------
# Telegram API credentials.  COPY this file to  secrets/.env  and fill in your
# real values.  This TEMPLATE is tracked (it holds no secrets); the secrets/.env
# you create from it is git-ignored and NEVER pushed, as is the .session file.
#
# Where to get these:  https://my.telegram.org  ->  "API development tools"
#   - create an app (title: screener, platform: Desktop)
#   - copy the api_id (a number) and api_hash (a long letters+numbers string)
#
# Your api_hash is password-equivalent. Keep this file on your PC only.
# ---------------------------------------------------------------------------

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=paste_your_api_hash_here
TELEGRAM_PHONE=+62812XXXXXXX

# ---------------------------------------------------------------------------
# OPTIONAL — phone notifications (see deploy/VPS-SETUP.md).
# Only needed if you run the screener unattended on a VPS and want the morning
# summary pushed to Telegram / to trigger runs with /run from your phone.
#
#   TELEGRAM_BOT_TOKEN  from @BotFather  ->  /newbot
#   TELEGRAM_CHAT_ID    message your bot once, then:
#                       py scripts/notify_telegram.py --whoami
#
# The bot listener obeys TELEGRAM_CHAT_ID and ignores every other sender — a bot
# username is discoverable, so this whitelist is what stops strangers triggering
# runs on your machine. On the VPS these two live in /etc/idx-screener.env
# instead, alongside SECTORS_API_KEY.
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=paste_your_bot_token_here
TELEGRAM_CHAT_ID=paste_your_chat_id_here
