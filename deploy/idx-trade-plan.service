[Unit]
Description=IDX Trade — pre-open plan
Documentation=https://github.com/andrebenas77/idx-telegram-screener
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=screener
Group=screener
WorkingDirectory=/home/screener/idx-telegram-screener

# INVEZGO_API_KEY and the Telegram bot keys arrive here. TRADE_EQUITY_IDR and
# TRADE_RISK_PCT may live either here or in secrets/trade.env — the environment
# wins, matching notify_telegram.py's precedence.
EnvironmentFile=/etc/idx-screener.env

Environment=PATH=/home/screener/.local/bin:/usr/local/bin:/usr/bin:/bin

# Separate lock from the 07:00 board: a slow build should delay this, not race it.
ExecStart=/usr/bin/flock -w 600 /tmp/idx-trade.lock \
    /usr/bin/python3 /home/screener/idx-telegram-screener/scripts/trade_plan.py \
    --summary --notify

TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
